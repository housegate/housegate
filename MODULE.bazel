module(
    name = "housegate",
    version = "1.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_img", version = "0.3.17")

# Bazel 9 removed native sh_binary; //bazel:docker needs rules_shell in the graph.
bazel_dep(name = "rules_shell", version = "0.8.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_alicebob_miniredis_v2", "com_github_bytedance_sonic", "com_github_celestiaorg_go_square_v2", "com_github_clickhouse_ch_go", "com_github_clickhouse_clickhouse_go_v2", "com_github_ethereum_go_ethereum", "com_github_google_uuid", "com_github_housegate_rewriter_go", "com_github_housegate_rewriter_proto", "com_github_prometheus_client_golang", "com_github_redis_go_redis_v9", "com_github_segmentio_asm", "com_github_sentioxyz_arbiter_proto", "com_github_shirou_gopsutil_v4", "com_github_testcontainers_testcontainers_go_modules_clickhouse", "com_github_zeebo_blake3", "in_yaml_go_yaml_v3", "io_filippo_age", "io_opentelemetry_go_otel_trace", "org_golang_google_grpc", "org_golang_x_crypto", "org_golang_x_sync", "org_golang_x_sys")

# Overrides below only apply when housegate is the root module (standalone
# build). When housegate is consumed as a dep (e.g. by sentio-node), these
# tags are skipped and the consumer's root MODULE.bazel must supply
# equivalent overrides for shared transitive deps.
go_deps_dev = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.module_override(
    patch_strip = 1,
    patches = ["//third_party:com_github_ethereum_go_ethereum_secp256k1.patch"],
    path = "github.com/ethereum/go-ethereum",
)
go_deps_dev.module_override(
    patch_strip = 1,
    patches = ["//third_party:com_github_consensys_gnark_crypto.patch"],
    path = "github.com/consensys/gnark-crypto",
)
go_deps_dev.gazelle_default_attributes(
    directives = ["gazelle:proto disable"],
)

bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    # NOTE: zig's darwin_arm64 toolchain is for CROSS-COMPILE FROM LINUX
    # only (hermetic_cc_toolchain does not support darwin as a build host
    # — zig's lld rejects Apple's `-Wl,-x` linker flag, breaking native
    # macOS builds). CI passes it via --extra_toolchains so it's
    # registered only for the cross-compile step. Local macOS users build
    # with the auto-detected Apple clang via cc_toolchain_resolution.
)

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "go_base_image",
    digest = "sha256:4e148a2af43caee0cbc72bc7705244d62be0d222749327e07f9d26edccd672db",
    registry = "gcr.io",
    repository = "distroless/base",
    tag = "debug",
)

