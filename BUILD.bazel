#load("@com_github_sluongng_nogo_analyzer//staticcheck:def.bzl", "ANALYZERS", "staticcheck_analyzers")
load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")

# Root BUILD.bazel - housegate library.
# Use `bazel build //cmd:housegate` to build the standalone binary.
# Use `bazel build //:housegate` to build the embeddable library.
load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "go_library", "go_test", "nogo")
load("@rules_multirun//:defs.bzl", "multirun")

go_library(
    name = "housegate",
    srcs = [
        "build.go",
        "proxy.go",
        "redis.go",
    ],
    importpath = "housegate/housegate",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/auth",
        "//pkg/billing",
        "//pkg/chproto",
        "//pkg/chsession",
        "//pkg/cluster",
        "//pkg/config",
        "//pkg/credentials",
        "//pkg/log",
        "//pkg/network",
        "//pkg/plugin",
        "//pkg/plugins/auth",
        "//pkg/plugins/commitgate",
        "//pkg/plugins/concurrency",
        "//pkg/plugins/credential",
        "//pkg/plugins/forward",
        "//pkg/plugins/metrics",
        "//pkg/plugins/rewrite",
        "//pkg/plugins/route",
        "//pkg/plugins/sessionstate",
        "//pkg/plugins/sidecar",
        "//pkg/plugins/usage",
        "//pkg/proxy",
        "//pkg/rewriter",
        "//pkg/secretsload",
        "//pkg/sqlmeta",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "housegate_test",
    srcs = [
        "build_test.go",
        "internal_port_integration_test.go",
        "pivot_integration_test.go",
        "proxy_test.go",
        "sidecar_auto_discover_integration_test.go",
        "use_pivot_integration_test.go",
    ],
    embed = [":housegate"],
    deps = [
        "//pkg/auth",
        "//pkg/chproto",
        "//pkg/chsession",
        "//pkg/config",
        "//pkg/network",
        "//pkg/peer",
        "//pkg/plugin",
        "//pkg/plugins/auth",
        "//pkg/plugins/forward",
        "//pkg/plugins/rewrite",
        "//pkg/plugins/sidecar",
        "//pkg/proxy",
        "//pkg/rewriter",
        "@com_github_clickhouse_ch_go//proto",
        "@sentio-core//network/registry",
    ],
)

nogo(
    name = "my_nogo",
    config = ":nogo-config.json",
    #    vet = True,
    visibility = ["//visibility:public"],
    deps = TOOLS_NOGO,
    #    + staticcheck_analyzers(STATICHECK_ANALYZERS) + [
    #        "@co_honnef_go_tools//analysis/lint",
    # analyzer from the local repository
    #        ":importunsafe",
    # analyzer from a remote repository
    #        "@org_golang_x_tools//go/analysis/passes/printf:go_default_library",
    #        "@org_golang_x_tools//go/analysis/passes/nilfunc:go_default_library",
    #        "@org_golang_x_tools//go/analysis/passes/bools:go_default_library",
    #        "@org_golang_x_tools//go/analysis/passes/atomic:go_default_library",
    #        "@org_golang_x_tools//go/analysis/passes/buildtag:go_default_library",
    #    ],
)

# gazelle:prefix housegate/housegate
gazelle(name = "gazelle")

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    visibility = ["//visibility:public"],
)

expand_template(
    name = "stamped",
    out = "_stamped.tags.txt",
    stamp_substitutions = {"dev": "{{VERSION}}"},
    template = ["dev"],
    visibility = ["//visibility:public"],
)
