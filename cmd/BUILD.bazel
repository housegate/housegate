load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "housegate_lib",
    srcs = [
        "console_handler.go",
        "fetch.go",
        "main.go",
        "secret.go",
    ],
    data = [
        "//configs:exported_configs_example",
    ],
    importpath = "github.com/housegate/housegate/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//:housegate",
        "//pkg/config",
        "//pkg/ffifetch",
        "//pkg/log",
        "//pkg/metricshttp",
        "//pkg/secretsload",
        "//pkg/version",
    ],
)

go_binary(
    name = "housegate",
    embed = [":housegate_lib"],
    visibility = ["//visibility:public"],
    # x_defs placeholders below are substituted from workspace_status.sh.
    # Substitution requires `--stamp` — enabled by default in //.bazelrc.
    x_defs = {
        "github.com/housegate/housegate/pkg/version.Version": "{STABLE_GIT_TAG}",
        "github.com/housegate/housegate/pkg/version.GitCommit": "{STABLE_GIT_COMMIT}",
        "github.com/housegate/housegate/pkg/version.BuildTime": "{BUILD_TIMESTAMP}",
    },
)

go_test(
    name = "cmd_test",
    srcs = ["main_test.go"],
    embed = [":housegate_lib"],  # keep
    deps = ["//pkg/config"],
)
