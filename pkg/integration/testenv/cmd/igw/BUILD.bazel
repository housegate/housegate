load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "igw_lib",
    srcs = ["main.go"],
    importpath = "housegate/housegate/pkg/integration/testenv/cmd/igw",
    visibility = ["//visibility:private"],
    deps = ["//pkg/interserver"],
)

go_binary(
    name = "igw",
    embed = [":igw_lib"],
    # Static, CGO-free (netgo) so the binary runs in the alpine gateway
    # container and resolves Docker network aliases via the Go resolver.
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
)
