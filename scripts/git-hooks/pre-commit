#!/usr/bin/env bash
#
# pre-commit hook — runs gitleaks against staged content to catch
# accidentally-staged secrets before they hit the local commit object.
#
# Wired up via `core.hooksPath` (see scripts/install-git-hooks.sh).
# Allowlist + rules live in .gitleaks.toml at the repo root.
#
# Bypass: `git commit --no-verify` (use sparingly — push hook can't
# catch what you skip here).
# Skip without bypassing other hooks: `HOUSEGATE_SKIP_GITLEAKS=1 git commit`.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# --- per-developer extension point -------------------------------------------
# Once this hook has decided the commit may proceed, run an optional,
# untracked local step if the developer has one. Teammates without
# scripts/git-hooks/pre-commit.local are unaffected. It is skipped when the
# commit is being aborted (e.g. gitleaks found a secret), and its own exit
# status never changes the commit outcome.
run_local_pre_commit() {
    local rc=$?
    if [[ $rc -eq 0 ]]; then
        local local_hook="${repo_root}/scripts/git-hooks/pre-commit.local"
        [[ -x "$local_hook" ]] && { "$local_hook" || true; }
    fi
    exit "$rc"
}
trap run_local_pre_commit EXIT

if [[ "${HOUSEGATE_SKIP_GITLEAKS:-0}" == "1" ]]; then
    echo "pre-commit: HOUSEGATE_SKIP_GITLEAKS=1 — skipping gitleaks scan." >&2
    exit 0
fi

if ! command -v gitleaks >/dev/null 2>&1; then
    cat >&2 <<'EOF'
pre-commit: gitleaks not found in PATH. Install it with:
    brew install gitleaks            # macOS
    # or: https://github.com/gitleaks/gitleaks/releases
Skipping secret scan for this commit. Re-install to re-enable.
EOF
    exit 0
fi

# `gitleaks git --staged` scans only what's staged for this commit
# (good for pre-commit per gitleaks docs). Default exit code 1 on
# findings, which aborts the commit.
gitleaks git --staged --redact --no-banner --config "${repo_root}/.gitleaks.toml" "${repo_root}"
